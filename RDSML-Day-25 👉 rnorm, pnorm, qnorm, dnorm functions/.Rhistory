x <- rnorm(10) # rnorm generates random numbers for normal or Gaussian distribution and here 10 indicates, we ask for 10 values
x
mean(x)
sd(x)
y <- rnorm(100)
y
mean(y)
sd(y)
z <- rnorm(1000)
z
mean(z)
sd(z)
p <- rnorm(10000)
p
mean(p)
sd(p)
hist(p)
a <- rnorm(10, mean = 100, sd = 5) # we want 10 values that will have mean near 100 and sd near 5)
a
mean(y)
sd(y)
mean(a)
sd(a)
b <- rnorm(100, mean = 100, sd =3)
b
mean(b)
sd(b)
setwd("/Volumes/Programming/Github/R-for-Data-Science-and-Machine-Learning-with-NBICT-LAB-Batch-8/RDSML-Day-25 👉 rnorm, pnorm, qnorm, dnorm functions")
# pnorm
# At z = 0, the value of probability is 0.5
pnorm(0)
pnorm(-1.96)
pnorm (-2)
# Thus, pnorm(-1.96) will give probability value of 0.02499 or 2.499%
# Thus, 2.5% values will fall outside of either side; in total 2.5% x 2 = 5%. From here, 95% confidence interval comes
pnorm(-1.64)
# qnorm is z value if probability value is provided
qnorm(.5)
qnorm(.25)
qnorm(-.25)
qnorm(.01)
qnorm(1)
qnorm(0.99)
# qnorm gives z value if probability value is provided
qnorm(.5)
qnorm(0.99)
qnorm(0.999)
qnorm(0.9999)
qnorm(0.99999)
qnorm(0.99999)
qnorm(0.999999)
qnorm(1)
# qnorm gives z value if probability value is provided. Probability values is between 0 and 1
qnorm(.5)
qnorm(0.25)
qnorm(-0.25)
qnorm(0.25)
qnorm(0.1)
qnorm(0.01)
qnorm(0.37)
qnorm(0.34)
# qnorm gives z value if probability value is provided. Probability values are between 0 and 1
qnorm(0.25)
#dnorm
# Y axis value for corresponding z values. For example,
dnorm(0)
<- seq(-4.0, 4.0, by = 0.1)
# Lets use dnorm to draw the normal distribution
zvalues <- seq(-4.0, 4.0, by = 0.1)
zvalues
dvalues <- dnorm(zvalues)
dvalues
plot(zvalue, dvalues)
plot(zvalues, dvalues)
