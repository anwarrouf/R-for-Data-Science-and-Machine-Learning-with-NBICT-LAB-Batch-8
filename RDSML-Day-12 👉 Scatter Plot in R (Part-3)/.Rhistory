library(ggplot2)
dataset = mtcars
View(dataset)
# Converting cyl column from a numeric to a factor variable
dataset$cyl = as.factor(dataset$cyl)
ggplot(dataset,aes(x=wt,y=mpg,color=cyl,shape=cyl))+
geom_point()+
geom_smooth(method=lm)
# removing confidence interval
ggplot(dataset,aes(x=wt,y=mpg,color=cyl,shape=cyl))+
geom_point()+
geom_smooth(method=lm,se=FALSE)
# filling the color of confidence bands
ggplot(dataset,aes(x=wt,y=mpg,color=cyl,shape=cyl))+
geom_point()+
geom_smooth(method=lm,fullrange=TRUE)
# filling the color of confidence bands
ggplot(dataset,aes(x=wt,y=mpg,color=cyl,shape=cyl))+
geom_point()+
geom_smooth(method=lm,aes(fill=cyl),fullrange=TRUE)
# filling the color of confidence bands
ggplot(dataset,aes(x=wt,y=mpg,color=cyl,shape=cyl))+
geom_point()+
geom_smooth(method=lm,aes(fill=cyl))
# Changing the point shapes manually
ggplot(dataset,aes(x=wt,y=mpg,color=cyl,shape=cyl))+
geom_point()+
geom_smooth(method=lm,se=F,fullrange=T)
# Changing the point shapes manually
ggplot(dataset,aes(x=wt,y=mpg,color=cyl,shape=cyl))+
geom_point(size=3)+
geom_smooth(method=lm,se=F,fullrange=T)
# Changing the point shapes manually
ggplot(dataset,aes(x=wt,y=mpg,color=cyl,shape=cyl))+
geom_point(size=3,shape=2)+
geom_smooth(method=lm,se=F,fullrange=T)
# Changing the point shapes manually
ggplot(dataset,aes(x=wt,y=mpg,color=cyl,shape=cyl))+
geom_point(size=3)+
geom_smooth(method=lm,se=F,fullrange=T)
# Changing the point shapes manually
ggplot(dataset,aes(x=wt,y=mpg,color=cyl,shape=cyl))+
geom_point(size=2)+
geom_smooth(method=lm,se=F,fullrange=T)
# Changing the point shapes manually
ggplot(dataset,aes(x=wt,y=mpg,color=cyl,shape=cyl))+
geom_point(size=3)+
geom_smooth(method=lm,se=F,fullrange=T)
# Changing the point shapes manually
ggplot(dataset,aes(x=wt,y=mpg,color=cyl,shape=cyl))+
geom_point(size=3)+
geom_smooth(method=lm,se=F,fullrange=T)+
scale_shape_manual(values=c(16,3,17))
# Changing the point shapes manually
ggplot(dataset,aes(x=wt,y=mpg,color=cyl,shape=cyl))+
geom_point(size=3)+
geom_smooth(method=lm,se=F,fullrange=T)+
scale_shape_manual(values=c(4,3,17))
# Changing the point shapes manually
ggplot(dataset,aes(x=wt,y=mpg,color=cyl,shape=cyl))+
geom_point(size=3)+
geom_smooth(method=lm,se=F,fullrange=T)+
scale_shape_manual(values=c(5,3,17))
# Changing the position of the legend
ggplot(dataset,aes(x=wt,y=mpg,color=cyl,shape=cyl))+
geom_point(size=3)+
geom_smooth(method=lm,se=F,fullrange=T)+
scale_shape_manual(values=c(5,3,17))+
theme(legend.position = "top")
# Changing the point colors manually
ggplot(dataset,aes(x=wt,y=mpg,color=cyl,shape=cyl))+
geom_point(size=3)+
geom_smooth(method=lm,se=F,fullrange=T)+
scale_shape_manual(values=c(5,3,17))+
scale_color_manual(values=c("darkblue","grey","orange"))+
theme(legend.position = "top")
# Customizing scatter plot
ggplot(dataset,aes(x=wt,y=mpg,color=cyl,shape=cyl))+
geom_point(size=3)+
geom_smooth(method=lm,se=F,fullrange=T)+
scale_shape_manual(values=c(5,3,17))+
scale_color_manual(values=c("darkblue","grey","orange"))+
labs(title="Miles per gallon according to the weight")+
theme(legend.position = "top")
# if the title is too long, then we can split it into two sentences
ggplot(dataset,aes(x=wt,y=mpg,color=cyl,shape=cyl))+
geom_point(size=3)+
geom_smooth(method=lm,se=F,fullrange=T)+
scale_shape_manual(values=c(5,3,17))+
scale_color_manual(values=c("darkblue","grey","orange"))+
labs(title="Miles per gallon \n according to the weight")+
theme(legend.position = "top")
# if the title is too long, then we can split it into two sentences
ggplot(dataset,aes(x=wt,y=mpg,color=cyl,shape=cyl))+
geom_point(size=3)+
geom_smooth(method=lm,se=F,fullrange=T)+
scale_shape_manual(values=c(5,3,17))+
scale_color_manual(values=c("darkblue","grey","orange"))+
labs(title="Miles per gallon \naccording to the weight")+
theme(legend.position = "top")
# Adding x and y axes label
ggplot(dataset,aes(x=wt,y=mpg,color=cyl,shape=cyl))+
geom_point(size=3)+
geom_smooth(method=lm,se=F,fullrange=T)+
scale_shape_manual(values=c(5,3,17))+
scale_color_manual(values=c("darkblue","grey","orange"))+
labs(title="Miles per gallon \naccording to the weight",x="Weight",y="Miles/Gallon")+
theme(legend.position = "top")
library.package(ggplot)
library.package(ggplot2)
library(ggplot2)
library(ggplot2)
dataset = mtcars
View(dataset)
drat_vs_qsec = dataset( ,c('drat','qsec'))
drat_vs_qsec = dataset[ ,c('drat','qsec')]
drat_vs_qsec
View(drat_vs_qsec)
ggplot(drat_vs_qsec,aes(x=drat,y=qsec))+
geom_point()
ggplot(drat_vs_qsec,aes(x=drat,y=qsec))+
geom_point()+
geom_smooth()
ggplot(drat_vs_qsec,aes(x=drat,y=qsec))+
geom_point()+
geom_line()
ggplot(drat_vs_qsec,aes(x=drat,y=qsec))+
geom_point()+
geom_line()+
theme(legened.position="top")
ggplot(drat_vs_qsec,aes(x=drat,y=qsec))+
geom_point()+
geom_line()+
labs(x="dratting",y="qsecond")
ggplot(drat_vs_qsec,aes(x=drat,y=qsec,size=3))+
geom_point()+
geom_line()+
labs(x="dratting",y="qsecond")
ggplot(drat_vs_qsec,aes(x=drat,y=qsec))+
geom_point()+
geom_line()+
labs(x="dratting",y="qsecond")
ggplot(drat_vs_qsec,aes(x=drat,y=qsec))+
geom_point(size=3)+
geom_line()+
labs(x="dratting",y="qsecond")
ggplot(drat_vs_qsec,aes(x=drat,y=qsec))+
geom_point(size=3)+
geom_line(linetype="dashed")+
labs(x="dratting",y="qsecond")
dataset$carb = as.factor(dataset$carb)
ggplot(dataset,aes(x=drat,y=qsec,col=carb))+
geom_point()+
geom_smooth()
ggplot(dataset,aes(x=drat,y=qsec,col=carb))+
geom_point()+
geom_smooth(method=lm)
ggplot(dataset,aes(x=drat,y=qsec,col=carb))+
geom_point()+
geom_smooth(method=lm,se=F)
ggplot(dataset,aes(x=drat,y=qsec,col=carb,size=carb))+
geom_point()+
geom_smooth(method=lm,se=F)
ggplot(dataset,aes(x=drat,y=qsec,col=carb,size=carb))+
geom_point()+
geom_smooth(method=lm,se=F)+
scale_color_manual(values=c(3,5,7))
ggplot(dataset,aes(x=drat,y=qsec,col=carb,size=carb))+
geom_point()+
geom_smooth(method=lm,se=F)+
scale_color_manual(values=c(3,5,7,9,11,13))
ggplot(dataset,aes(x=drat,y=qsec,col=carb,size=carb))+
geom_point()+
geom_smooth(method=lm,se=F)+
scale_color_manual(values=c(3,5,7,9,11,13))+
theme(title.position='top')
ggplot(dataset,aes(x=drat,y=qsec,col=carb,size=carb))+
geom_point()+
geom_smooth(method=lm,se=F)+
scale_color_manual(values=c(3,5,7,9,11,13))+
theme(legend.position='top')
