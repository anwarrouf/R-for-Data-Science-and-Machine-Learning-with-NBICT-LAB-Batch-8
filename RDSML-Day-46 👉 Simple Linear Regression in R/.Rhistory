mtcars
car_data = mtcars
library(ggplot2)
ggplot(car_data, aes(x = wt, y = mpg))+
geom_point()
car_data$cyl = as.factor(car_data$cyl)
ggplot(car_data, aes(x = wt, y = mpg))+
geom_point()
ggplot(car_data, aes(x = wt, y = mpg))+
geom_point(aes(color = cyl))
ggplot(car_data, aes(x = wt, y = mpg))+
geom_point(aes(color = cyl))+
geom_line()
ggplot(car_data, aes(x = wt, y = mpg))+
geom_point(aes(color = cyl))+
geom_line(method = lm)
ggplot(car_data, aes(x = wt, y = mpg))+
geom_point(aes(color = cyl))+
geom_smooth(method = lm)
ggplot(car_data, aes(x = wt, y = mpg))+
geom_point(aes(color = cyl))+
geom_smooth(method = loess)
ggplot(car_data, aes(x = wt, y = mpg))+
geom_point(aes(color = cyl))+
geom_smooth(aes(color = cyl), method = loess))
# changing point size for cyl
ggplot(dataset, aes(x = wt, y = mpg, color = cyl)) +
geom_point(size = 3) +
geom_smooth(method = lm)
dataset = mtcars
# Generating a basic scatter plot
# independent variable in x-axis, dependent variable in y-axis
ggplot(dataset,aes(x = wt, y = mpg)) +
geom_point()
ggplot(dataset, aes(x = wt, y = mpg)) +
geom_point(size = 2,shape = 8)
ggplot(dataset, aes(x = wt, y = mpg)) +
geom_point(size = 2,shape = 8) +
geom_smooth(method = lm)
ggplot(dataset, aes(x = wt, y = mpg)) +
geom_point(size = 3, shape = 9) +
geom_smooth(method = lm, se = FALSE)
# Loess method, if we do not select any specific method, then loess line will be shown
# loess means locally estimated scatter smoothing
ggplot(dataset, aes(x = wt, y = mpg)) +
geom_point(size = 3, shape = 9) +
geom_smooth(method = loess)
dataset$cyl = as.factor(dataset$cyl)
ggplot(dataset, aes(x = wt, y = mpg, shape  = cyl)) +
geom_point()
# changing point shape and color for cyl
ggplot(dataset, aes(x = wt, y = mpg, shape  = cyl, color = cyl, size = cyl)) +
geom_point() # we can differentiate the factor variable by size, shape and color or only size, shape and color
# changing point size for cyl
ggplot(dataset, aes(x = wt, y = mpg, color = cyl)) +
geom_point(size = 3) +
geom_smooth(method = lm)
ggplot(car_data, aes(x = wt, y = mpg, color = cyl))+
geom_point()+
geom_smooth(method = loess))
ggplot(car_data, aes(x = wt, y = mpg, color = cyl))+
geom_point()+
geom_smooth(method = lm))
ggplot(car_data, aes(x = wt, y = mpg, color = cyl))+
geom_point()+
geom_smooth(method = lm)
ggplot(car_data, aes(x = wt, y = mpg, color = cyl))+
geom_point()+
geom_smooth(method = loess)
# Checking the summary of regressor
summary(regressor)
regressor # আমাদের model তৈরি করা হয়ে গেছে। আজ ক্লাস এ পর্যন্তই।
setwd("/Volumes/Programming/Github/R-for-Data-Science-and-Machine-Learning-with-NBICT-LAB-Batch-8/RDSML-Day-46 👉 Simple Linear Regression in R")
dataset <- read.csv("Salary_Data.csv")
# We want to select randomly 20 values from the dataset. This will work as training set.
# For random selection, we will use caTools package
install.packages("caTools")
library(caTools)
training_set_1 <- sample.split(Y = dataset$Salary, SplitRatio = 2/3)
# normally we plot dependent variable in Y axis. That's why, Y is written. We do not need to write Y.
training_set_1
# We got a combination of TRUE and FALSE data.
# TRUE means the value selected for training set
# FALSE means the values not selected for training set. These not selected values will be used as test set
training_set_2 <- sample.split(Y= dataset$Salary, SplitRatio = 2/3)
training_set_2 # Running the code again will give a new combination
# That's why, we want a definite set of random values for training set
set.seed(67) # I randomly select the value
training_set_1 <- sample.split(Y = dataset$Salary, SplitRatio = 2/3)
training_set_1
# Lets use,
set.seed(123) # We all participatants in the class are now using sample seed value which will select sample random combination
training_set_1 <- sample.split(Y = dataset$Salary, SplitRatio = 2/3)
training_set_1
# Creating the training subset by combining all TRUE values
training_set_final <- subset(dataset, training_set_1 == TRUE)
test_set_final <- subset(dataset, training_set_1 == FALSE)
test_set_final
regressor <- lm(formula = Salary ~ YearsExperience,
data = training_set_final)
regressor # আমাদের model তৈরি করা হয়ে গেছে। আজ ক্লাস এ পর্যন্তই।
# Checking the summary of regressor
summary(regressor)
y_pred <- predict(regressor, newdata = test_set_final)
y_pred
library(ggplot2)
ggplot()
ggplot()+
geom_point(aes(x = training_set_final$YearsExperience, y = training_set_final$Salary))
ggplot()+
geom_point(aes(x = training_set_final$YearsExperience, y = training_set_final$Salary), color = "red")
ggplot()+
geom_point(aes(x = training_set_final$YearsExperience, y = training_set_final$Salary), color = "red")+
labs(xlab = "Years of Experience", Y = "Salary")
ggplot()+
geom_point(aes(x = training_set_final$YearsExperience, y = training_set_final$Salary), color = "red")+
labs(xlab = "Years of Experience", Y = "Salary")
ggplot()+
geom_point(aes(x = training_set_final$YearsExperience, y = training_set_final$Salary), color = "red")+
labs(x = "Years of Experience", y = "Salary")
y_pred <- predict(regressor, newdata = training_set_final)
y_pred_test <- predict(regressor, newdata = test_set_final)
y_pred_training <- predict(regressor, newdata = training_set_final)
y_pred_test
y_pred_training
