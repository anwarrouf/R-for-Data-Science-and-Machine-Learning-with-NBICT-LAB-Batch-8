# Importing data
data <- read.csv("scores.csv")
library(BSDA)
# Checking for the normal distribution
shapiro.test(data$Male)
shapiro.test(data$Female)
library(BSDA)
library(BSDA)
var.test(x = data$Male,
y = data$Female)
t.test(x = data$Male,
y = data$Female,
paired = FALSE, # it is by default FALSE,
var.equal = TRUE)
