setwd("/Volumes/Temporary/Github/R-for-Data-Science-and-Machine-Learning-with-NBICT-LAB-Batch-8/RDSML-Day-15 👉 Barplot in R (Part-1)")
data = data.frame(dose = c(0.5,1,2),length = c(4.2,10,29.5))
data
dataset = data.frame(dose = c(0.5,1,2),length = c(4.2,10,29.5))
dataset
dataset = data.frame(dose = c("D0.5","D1","D2"),length = c(4.2,10,29.5))
dataset
View(dataset)
library(dplyr)
dataset |> mutate(effect = c("weak","moderate","strong"))
dataset
new_dataset = dataset |>
mutate(effect = c("weak","moderate","strong"))
View(new_dataset)
library(ggplot2)
ggplot(dataset, aes(x=dose,y=length))+
geom_bar(stat = "identity")
# The above one is a vertical barplot. To create horizontal barplot,
ggplot(dataset, aes(x=dose,y=length))+
geom_bar(stat = "identity")+
coord_flip()
# To change the width of bars
ggplot(dataset, aes(x=dose,y=length))+
geom_bar(stat = "identity",width = 0.5)
# To change the width of bars
ggplot(dataset, aes(x=dose,y=length))+
geom_bar(stat = "identity",width = 0.75)
# To change the border color of bars
ggplot(dataset,aes(x = dose, y = length))+
geom_bar(stat = "identity", width = 0.5, color = "blue", fill = "red")
# To change the border and fill colors of bars
ggplot(dataset,aes(x = dose, y = length))+
geom_bar(stat = "identity", width = 0.5, color = "blue", fill = "lightpink")
# minimal theme with blue fill color
ggplot(dataset,aes(x = dose, y = length))+
geom_bar(stat = "identity", fill = "steelblue")+
theme_minimal()
data = c(1,2,4,5,6,8,10)
summary(data)
sd(data)
# minimal theme with blue fill color
ggplot(dataset,aes(x = dose, y = length))+
geom_bar(stat = "identity", fill = "steelblue",color="yellow")+
theme_minimal()
