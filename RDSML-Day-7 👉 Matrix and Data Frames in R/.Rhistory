stu_hours_mat
subject_marks_mat = matrix(subject_marks)
subject_marks_mat
hours_marks = matrix(stu_hours_mat,subject_marks_mat,byrow=FALSE,ncol=2)
hours_marks = matrix(stu_hours_mat,subject_marks_mat,byrow=FALSE,nrow=5)
hours_marks
hours_marks = matrix(stu_hours,subject_marks,byrow=F,ncol=2)
