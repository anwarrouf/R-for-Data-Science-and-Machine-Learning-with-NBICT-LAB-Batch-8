setwd("/Volumes/Programming/Github/R-for-Data-Science-and-Machine-Learning-with-NBICT-LAB-Batch-8/RDSML-Day-32 👉 One Sample Z Test Using the BSDA Package")
# Importing data set
dataset <- read.csv("Perfume.csv")
View(dataset)
install.packages("BSDA") # Basic statistics and data analysis
library(BSDA)
mean(dataset$Machine.1)
z.test(x=dataset$Machine.1, # as only one sample, that's why no y value here
alternative = "greater", # greater, less, two-sided
mu = 150,
sigma.x = 2)
z.test(x=dataset$Machine.1, # as only one sample, that's why no y value here
alternative = "greater", # greater, less, two-sided
mu = 150,
sigma.x = 2,
conf.level = 0.99)
z.test(x=dataset$Machine.1, # as only one sample, that's why no y value here
alternative = "greater", # greater, less, two-sided
mu = 150,
sigma.x = 2,
conf.level = 0.95)
setwd("/Volumes/Programming/Github/R-for-Data-Science-and-Machine-Learning-with-NBICT-LAB-Batch-8/RDSML-Day-33 👉 One Sample T Test")
setwd("/Volumes/Programming/Github/R-for-Data-Science-and-Machine-Learning-with-NBICT-LAB-Batch-8/RDSML-Day-33 👉 One Sample T Test")
data <- read.csv("bottle_data.csv")
View(data)
library(BSDA)
t.test(x = data$value,
alternative = "two-sided",
mu = 150)
t.test(x = data$value,
alternative = "two.sided",
mu = 150)
mean(data$value)
shapiro.test(data$value)
# Performing one sample t-test
t.test(x = data$value, mu = 150, conf.level = 0.95)
t.test(x = data$value,
mu = 150)
t.test(x = data$value,
mu = 150)
