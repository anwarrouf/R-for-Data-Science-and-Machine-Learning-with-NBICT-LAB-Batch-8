# 1) ---- Install & load packages (run once for install) and load libraries
install.packages(c("ggplot2", "pheatmap"))         # if not installed
# 1) ---- Install & load packages (run once for install) and load libraries
install.packages(c("ggplot2", "pheatmap"))         # if not installed
n_genes   <- 100
n_samples <- 6
sample_ids <- paste0("Sample", 1:n_samples)
condition  <- factor(rep(c("Control", "Treatment"), each = 3),
levels = c("Control", "Treatment"))
##Simulate “true” mean expression per gene in Control
# Base mean counts (some low, some high)
base_means <- rlnorm(n_genes, meanlog = 4, sdlog = 0.5)  # ~ mean 50–100
## Add fold change for some DE genes in Treatment
de_genes <- 1:20                       # first 20 genes are DE
log2FC_true <- rep(0, n_genes)
## Matrix to hold mean for each gene × sample
mu <- matrix(NA, nrow = n_genes, ncol = n_samples,
dimnames = list(paste0("Gene", 1:n_genes), sample_ids))
for (i in 1:n_genes) {
for (j in 1:n_samples) {
if (condition[j] == "Control") {
mu[i, j] <- base_means[i]
} else {
mu[i, j] <- base_means[i] * 2^(log2FC_true[i])
}
}
}
dispersion <- 0.2   # one common dispersion for simplicity
counts <- matrix(rnbinom(n_genes * n_samples,
mu = as.vector(mu),
size = 1/dispersion),
nrow = n_genes, ncol = n_samples,
dimnames = list(rownames(mu), colnames(mu)))
head(counts)
coldata <- data.frame(
row.names  = sample_ids,
condition  = condition
)
coldata
dds <- DESeqDataSetFromMatrix(countData   = counts,
colData     = coldata,
design      = ~ condition)
library(DESeq2)
dds <- DESeqDataSetFromMatrix(countData   = counts,
colData     = coldata,
design      = ~ condition)
## Optional: pre-filter very low-count genes
keep <- rowSums(counts(dds)) >= 10
dds  <- dds[keep, ]
dds
dds <- DESeq(dds)
## Extract results (Treatment vs Control)
res <- results(dds, contrast = c("condition", "Treatment", "Control"))
head(res)
summary(res)
sizeFactors(dds)          # library size correction
norm_counts <- counts(dds, normalized = TRUE)
head(norm_counts)
vsd <- vst(dds, blind = TRUE)
vsd <- vst(dds, blind = TRUE)
sample_dist <- dist(t(assay(vsd)))
