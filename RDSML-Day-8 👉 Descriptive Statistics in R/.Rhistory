library(psych)
setwd("/Volumes/Programming/Github/R-for-Data-Science-and-Machine-Learning-with-NBICT-LAB-Batch-8/RDSML-Day-8 👉 Descriptive Statistics in R")
data()
AirPassengers
BOD
# Using the New York flight data
install.packages("nycflights13")
install.packages("nycflights13")
# On the other hand, if we need to use given data of a package, then we use attach().
# In nycflights13, there are lots of data, we want to take only flights. :: is used to choose specific data
attach(nycflights13::flights)
# Let look at the first six records using the head() function. Head() shows first 6 rows. If we want to see more rows, then put the number)
head(nycflights13::flights)
# If we want to see whole dataset, then we have to do
nycflights13::flights
# If we want to see last six rows of a data set, then we use tail function
tail(nycflights13::flights)
summary(distance)
# Summary is a base package of R. In psych package, there is a function- describe like summary function, that gives more details
describe(distance)
binding_columns  = cbind(arr_delay,dep_delay, distance)
binding_columns
# Now we can use describe function
describe(binding_columns)
