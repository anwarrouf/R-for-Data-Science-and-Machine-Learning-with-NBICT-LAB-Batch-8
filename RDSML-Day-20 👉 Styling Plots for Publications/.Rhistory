setwd("/Volumes/Programming/Github/R-for-Data-Science-and-Machine-Learning-with-NBICT-LAB-Batch-8/RDSML-Day-20 👉 Styling Plots for Publications")
ggplot(df,aes(x = wt, y = mpg, color = cyl)) +
geom_point(size = 3) +
scale_color_viridis_d(name = "Cylinders") +
labs(
title = "Fuel Efficiency by Car weight",
x = "Weight (1000 lbs)",
y = "Miles per Gallon"
) +
theme_classic(base_size = 12, base_family = "serif") +
theme(plot.title = element_text(face = "bold", size = 16, hjust = 0.5),
axis.title = element_text(face = "bold", size = 11),
legend.position = "right",
legend.title = element_text(face = "bold"),
legend.text = element_text(size = 12)
)
