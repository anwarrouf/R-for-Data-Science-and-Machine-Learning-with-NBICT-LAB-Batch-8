setwd("/Volumes/Temporary/Github/R-for-Data-Science-and-Machine-Learning-with-NBICT-LAB-Batch-8/RDSML-Day-10 👉 Scatter Plot in R (Part-1)")
# Install and loading ggplot2
# gg stands for grammer of graph
install.packages("ggplot2")
library(ggplot2)
dataset = mtcars
View(dataset)
# Generating a basic scatter plot
# independent variable in x-axis, dependent variable in y-axis
ggplot(dataset,aes(x = wt, y = mpg)) +
geom_point()
ggplot(dataset, aes(x = wt, y = mpg)) +
geom_point(size = 2)
ggplot(dataset, aes(x = wt, y = mpg)) +
geom_point(size = 3)
ggplot(dataset, aes(x = wt, y = mpg)) +
geom_point(size = 4)
ggplot(dataset, aes(x = wt, y = mpg)) +
geom_point(size = 0.5)
ggplot(dataset, aes(x = wt, y = mpg)) +
geom_point(size = 1)
ggplot(dataset, aes(x = wt, y = mpg)) +
geom_point(size = 2)
ggplot(dataset, aes(x = wt, y = mpg)) +
geom_point(size = 2,shape = 2)
ggplot(dataset, aes(x = wt, y = mpg)) +
geom_point(size = 2,shape = 1)
ggplot(dataset, aes(x = wt, y = mpg)) +
geom_point(size = 2,shape = 3)
ggplot(dataset, aes(x = wt, y = mpg)) +
geom_point(size = 2,shape = 4)
ggplot(dataset, aes(x = wt, y = mpg)) +
geom_point(size = 2,shape = 5)
ggplot(dataset, aes(x = wt, y = mpg)) +
geom_point(size = 2,shape = 6)
ggplot(dataset, aes(x = wt, y = mpg)) +
geom_point(size = 2,shape = 7)
ggplot(dataset, aes(x = wt, y = mpg)) +
geom_point(size = 2,shape = 8)
ggplot(dataset, aes(x = wt, y = mpg)) +
geom_point(size = 2,shape = 9)
ggplot(dataset, aes(x = wt, y = mpg)) +
geom_point(size = 2,shape = 3)
ggplot(dataset, aes(x = wt, y = mpg)) +
geom_point(size = 2,shape = 2)
ggplot(dataset, aes(x = wt, y = mpg)) +
geom_point(size = 2,shape = 8)
