setwd("/Volumes/Programming/Github/R-for-Data-Science-and-Machine-Learning-with-NBICT-LAB-Batch-8/RDSML-Day-40 👉 Two way ANOVA (part 2)")
residuals(m)
# Importing data
data <- read.csv("cropdata.csv")
library(dplyr)
stats <- data %>%
group_by(fert,irr) %>%
summarise(mean_yield = mean(y),
se_yield = sd(y)/n())
# Data visualization
library(ggplot2)
ggplot(stats, aes(x = irr, y = mean_yield, group = fert)) +
geom_line() +
geom_point(size = 2) +
geom_errorbar(mapping = aes(ymin = mean_yield - se_yield, ymax = mean_yield + se_yield), width = 0.2) +
facet_wrap(facets = ~ fert, nrow = 1, ncol = 3) +
labs(x  = "Irrigation", y = "Mean yield",
title = "Interaction of fertilizer and irrigation on crop yield") +
theme_classic(base_size = 12)
m <- aov(formula = y ~ fert + irr + fert*irr,
data = data)
summary(m)
par(mfrow = c(2,2))
plot(m) # this will create 4 plots. To arrange these 4 plots, we need to run 'par' function first
residuals(m)
View(data)
View(stats)
residuals <- data %>%
group_by(fert, irr) %>%
mutate(residuals = residuals())
shapiro.test(res)
res <- residuals(m)
shapiro.test(res)
# Levene's test for equal variances
library(carr)
# Levene's test for equal variances
library(car)
leveneTest(y ~ fert*irr, data = data, center = median)
leveneTest(y ~ fert*irr, data = data, center = median())
leveneTest(y ~ fert*irr, data = data, center = median)
car::leveneTest(y ~ fert*irr, data = data, center = median)
library(emmeans)
contrast(emmeans(m, ~ fert | irr), method = "pairwise", adjust = "tukey")
ID = 1:10
